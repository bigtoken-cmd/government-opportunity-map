{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "government-opportunity-map",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "OPPORTUNITY_SEARCH_CLIENT_LIMITER",
      "namespace_id": "26081503",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "OPPORTUNITY_SEMANTIC_CLIENT_LIMITER",
      "namespace_id": "26081501",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "OPPORTUNITY_SEMANTIC_GLOBAL_LIMITER",
      "namespace_id": "26081502",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "WORKSPACE_DB",
      "database_name": "government-opportunity-map-workspace",
      "database_id": "d6de4928-59f8-471f-8565-e691ad948a15"
    }
  ]
}
